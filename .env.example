POSTGRES_DB=cinema
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_dev_password
SECRET_KEY=change-this-long-random-key-in-production
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=AdminDemo123!
MAIL_FROM=cinema@local.test
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# The ONLY difference between dev and prod: where Firestore is connected.
# dev: docker compose --profile dev up --build -d
FIRESTORE_MODE=emulator
FIRESTORE_PROJECT_ID=cinema-lab-local
FIRESTORE_EMULATOR_HOST=firestore-emulator:8080
# prod: set FIRESTORE_MODE=cloud, FIRESTORE_EMULATOR_HOST= (empty), project ID and credentials
# Mount credentials JSON as ./secrets/firestore-service-account.json (do not commit).
GOOGLE_APPLICATION_CREDENTIALS=
